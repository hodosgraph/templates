{
  "$schema": "../schemas/target-profile-v1alpha1.schema.json",
  "apiVersion": "templates.hodosgraph.com/v1alpha1",
  "kind": "TargetProfile",
  "metadata": {
    "id": "azure-agents",
    "name": "Azure AI Foundry agents"
  },
  "spec": {
    "provider": "azure",
    "maturity": "scaffold",
    "artifact": {
      "format": "oci-image",
      "architectures": ["linux/amd64"],
      "registry": "Azure Container Registry"
    },
    "agentHosting": ["Azure AI Foundry Hosted Agent"],
    "mcpHosting": ["Azure Container Apps"],
    "delivery": {
      "method": "Hodos Workflow placement driver",
      "immutableReferenceRequired": true
    },
    "identity": {
      "ci": "GitHub OIDC to source registry only",
      "deployment": "Hodos Workflow federated Entra identity",
      "runtime": "Dedicated managed identity"
    },
    "events": {
      "mode": "Entra-authenticated Event Grid webhook plus periodic reconciliation",
      "authoritativeRefresh": true
    },
    "documentation": {
      "guide": null,
      "verifiedAt": null,
      "note": "Not published as supported until the live Azure gate passes."
    }
  }
}
