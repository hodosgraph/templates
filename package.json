{
  "name": "@hodosgraph/templates-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run validate && npm run docs:check && npm test",
    "docs:check": "node scripts/generate-support-matrix.mjs --check && node scripts/check-docs.mjs",
    "docs:matrix": "node scripts/generate-support-matrix.mjs",
    "test": "node --test",
    "validate": "node scripts/validate-catalog.mjs && node scripts/validate-authoring-example.mjs"
  }
}
