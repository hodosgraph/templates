{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/community-incident-agent/inputs.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_name", "description", "dependency_updater"],
  "properties": {
    "unit_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "dependency_updater": {
      "enum": ["dependabot", "renovate"]
    }
  }
}
