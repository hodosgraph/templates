{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.hodosgraph.com/schemas/catalog-v1alpha1.schema.json",
  "title": "HodosGraph template catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "templates.hodosgraph.com/v1alpha1" },
    "kind": { "const": "TemplateCatalog" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "publisher"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "publisher": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templates", "targetProfiles"],
      "properties": {
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "manifest", "conformance"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
              "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
              "manifest": { "type": "string", "minLength": 1 },
              "conformance": {
                "type": "object",
                "additionalProperties": false,
                "required": ["framework", "deterministicMode", "mcp", "openTelemetry", "level"],
                "properties": {
                  "framework": { "type": "string", "minLength": 1 },
                  "deterministicMode": { "type": "boolean" },
                  "mcp": { "enum": ["not-applicable", "minimal-handwritten", "official-sdk"] },
                  "openTelemetry": { "enum": ["none", "otlp"] },
                  "level": { "enum": ["scaffold", "gold"] }
                }
              }
            }
          }
        },
        "targetProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
